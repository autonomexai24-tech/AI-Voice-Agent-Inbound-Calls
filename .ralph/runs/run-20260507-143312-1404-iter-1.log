diff --git a/frontend/app/globals.css b/frontend/app/globals.css
new file mode 100644
index 0000000000000000000000000000000000000000..ac5258a4d0387be79e4b5acea839dcb860ad75a3
--- /dev/null
+++ b/frontend/app/globals.css
@@ -0,0 +1,83 @@
+:root {
+  color-scheme: light;
+  font-family:
+    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  background: #f6f7f9;
+  color: #16181d;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  min-height: 100%;
+  margin: 0;
+}
+
+body {
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(246, 247, 249, 0.96)),
+    #f6f7f9;
+}
+
+.shell {
+  display: grid;
+  min-height: 100vh;
+  place-items: center;
+  padding: 32px 20px;
+}
+
+.panel {
+  width: min(100%, 760px);
+  border: 1px solid #dfe3ea;
+  border-radius: 8px;
+  background: #ffffff;
+  padding: 32px;
+  box-shadow: 0 20px 50px rgba(22, 24, 29, 0.08);
+}
+
+.eyebrow {
+  margin: 0 0 12px;
+  color: #4c6fff;
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0;
+  text-transform: uppercase;
+}
+
+h1 {
+  margin: 0;
+  font-size: clamp(2rem, 4vw, 3.5rem);
+  line-height: 1.05;
+  letter-spacing: 0;
+}
+
+.summary {
+  max-width: 620px;
+  margin: 18px 0 0;
+  color: #4c5564;
+  font-size: 1rem;
+  line-height: 1.65;
+}
+
+.checks {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 12px;
+  margin: 28px 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.checks li {
+  min-height: 52px;
+  border: 1px solid #e5e8ef;
+  border-radius: 8px;
+  background: #fbfcfe;
+  padding: 14px 16px;
+  color: #252a33;
+  font-size: 0.95rem;
+  line-height: 1.35;
+}
