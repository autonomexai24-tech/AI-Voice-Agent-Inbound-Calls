diff --git a/supervisord.conf b/supervisord.conf
index 00555308653856210dfe182a0aee756cb2e8d1aa..754a3f695f4ba3a875ace04a9731d31b9986c350
--- a/supervisord.conf
+++ b/supervisord.conf
@@ -3,9 +3,10 @@
 logfile=/dev/null
 logfile_maxbytes=0
 
-[program:agent]
+[program:voice_agent]
 command=python agent.py start
 directory=/app
+environment=PYTHONUNBUFFERED="1",PYTHONDONTWRITEBYTECODE="1"
 autostart=true
 autorestart=true
 startretries=10
@@ -15,9 +16,10 @@
 stdout_logfile=/dev/stdout
 stdout_logfile_maxbytes=0
 
-[program:ui_server]
-command=uvicorn ui_server:app --host 0.0.0.0 --port 8000 --workers 1
-directory=/app
+[program:next_dashboard]
+command=node server.js
+directory=/app/frontend/.next/standalone
+environment=NODE_ENV="production",NEXT_TELEMETRY_DISABLED="1",HOSTNAME="0.0.0.0",PORT="8000"
 autostart=true
 autorestart=true
 startretries=5

exec
"C:\\Program Files\\WindowsApps\\Microsoft.PowerShell_7.6.1.0_x64__8wekyb3d8bbwe\\pwsh.exe" -Command 'git add .ralph/progress.md; git add -f .ralph/activity.log; git commit -m "Record FR-001 progress"; git status --porcelain' in C:\AI Voice Agent for Inbound Calls\InboundAIVoice-main
