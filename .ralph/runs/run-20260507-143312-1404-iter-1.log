+}
+
+h1 {
+  margin: 0;
+  font-size: clamp(2rem, 4vw, 3.5rem);
+  line-height: 1.05;
+  letter-spacing: 0;
+}
+
+.summary {
+  max-width: 620px;
+  margin: 18px 0 0;
+  color: #4c5564;
+  font-size: 1rem;
+  line-height: 1.65;
+}
+
+.checks {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
