+    #f6f7f9;
+}
+
+.shell {
+  display: grid;
+  min-height: 100vh;
+  place-items: center;
+  padding: 32px 20px;
+}
+
+.panel {
+  width: min(100%, 760px);
+  border: 1px solid #dfe3ea;
+  border-radius: 8px;
