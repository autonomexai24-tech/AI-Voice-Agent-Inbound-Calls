# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=

# Sarvam AI
SARVAM_API_KEY=

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Fast2SMS
# Production value provided by the project owner. Keep the real key in Easypanel or local .env only.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Dashboard Security
# Use one strong password to protect the operator dashboard.
DASHBOARD_PASSWORD=change_this_dashboard_password

# Self-Hosted Supabase via Kong
# Local development example: http://localhost:8000
# Production should use the internal VPS/Kong URI, for example: http://supabase-kong:8000
SUPABASE_SELF_HOSTED_URL=http://localhost:8000
SUPABASE_ANON_KEY=your_self_hosted_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_self_hosted_supabase_service_role_key_here
